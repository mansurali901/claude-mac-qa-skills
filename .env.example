# .env.example — QA environment variables
# Copy this file to .env.qa and fill in real values.
# NEVER commit .env.qa — it is gitignored.
# ============================================================
# Everything the test suite reads comes from here.
# No URLs, credentials, or config are hardcoded anywhere else.
# ============================================================

# ── App under test ────────────────────────────────────────────
# Web: full base URL (trailing slash required)
QA_APP_URL=

# macOS / Windows: app name as it appears in /Applications or Start Menu
QA_APP_NAME=

# ── Auth credentials ──────────────────────────────────────────
# Primary test account (must be a dedicated test account, not personal)
QA_TEST_EMAIL=
QA_TEST_PASSWORD=

# Pre-existing account used for duplicate-email tests (TC-017)
QA_EXISTING_EMAIL=

# Account tier for the test account
QA_ACCOUNT_TIER=free

# ── Sandbox mode ──────────────────────────────────────────────
# Prevents destructive actions (delete, reset, uninstall) during test runs
QA_SANDBOX_MODE=true

# ── LLM API keys (for onboarding/API-key flow tests) ─────────
# These are the keys pasted INTO the app during onboarding tests.
# They are NOT used to call Claude/OpenAI directly.
QA_LLM_PROVIDER=claude
QA_LLM_API_KEY=

# ── Secondary account (multi-user / sharing tests) ────────────
QA_SECONDARY_EMAIL=
QA_SECONDARY_PASSWORD=

# ── BFS Crawl tuning (web skill) ─────────────────────────────
# Minimum wait (ms) after each page loads before screenshotting.
# Increase for slow apps, decrease for fast static sites.
QA_PAGE_WAIT_MS=2000

# Maximum pages the BFS crawler will visit in one run.
QA_MAX_PAGES=50

# Maximum click-depth from the homepage. Pages deeper than this are skipped.
QA_MAX_DEPTH=5

# Navigation timeout (ms) — how long to wait for a page.goto() to resolve.
QA_NAV_TIMEOUT=15000

# ── Browser visibility (web skill) ────────────────────────────
# "false" = visible Chromium window (debugging). Anything else (or unset) = headless.
QA_HEADLESS=true

# ── Login engagement tuning (web skill) ──────────────────────
# Max ms to wait for the auth POST response after clicking Sign In.
QA_AUTH_WAIT_MS=5000

# Per-keystroke delay when typing into login fields (helps with paste-blocked / rate-limited fields).
QA_TYPING_DELAY_MS=50

# Opt-in: write a HAR of just the auth step to qa/har/auth-<role>.har
QA_AUTH_HAR=0

# ── Per-role credentials (web skill, multi-role apps) ────────
# Discovered roles get their own slot — see qa/knowledgebase/roles.md.
# QA_TEST_EMAIL / QA_TEST_PASSWORD remains the default ("member") role.
# QA_<ROLE>_STORAGE_STATE is auto-filled by the skill after first successful login.
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=
QA_ADMIN_STORAGE_STATE=

# Add other roles as needed: QA_OWNER_EMAIL, QA_VIEWER_EMAIL, etc.

# ── CI ────────────────────────────────────────────────────────
CI_ENVIRONMENT=local
CI_RUN_ID=